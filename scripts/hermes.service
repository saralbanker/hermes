[Unit]
Description=Hermes job pipeline (discover → score → tailor → apply)
Wants=network-online.target
After=network-online.target ollama.service

[Service]
Type=oneshot
WorkingDirectory=/mnt/data/rj/hermes
ExecStart=/mnt/data/rj/hermes/scripts/run_hermes.sh
TimeoutStartSec=5h
Nice=5
# Kill only this unit's own processes (Chrome/Xvfb children) when it stops.
KillMode=control-group
